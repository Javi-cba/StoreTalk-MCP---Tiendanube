# Local dev reads the monorepo root .env (shared with the frontend).
# On deploy (only /backend built) put these in backend/.env or real env vars.

ENVIRONMENT=development
LOG_LEVEL=INFO
TOOL_DEADLINE_SECONDS=20
FRONTEND_ORIGIN=http://localhost:3000
# URL pública del backend: issuer del OAuth del MCP. En local, el túnel de ngrok (https://xxx.ngrok-free.dev)
PUBLIC_BASE_URL=http://localhost:8000

# Neon. postgresql:// is accepted (converted to postgresql+psycopg://).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional: direct endpoint for Alembic. Defaults to DATABASE_URL without "-pooler".
DATABASE_URL_DIRECT=

# 32 bytes base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Never rotate without a re-encryption migration (stored tokens depend on it).
ENCRYPTION_KEY=
API_KEY_PEPPER=

# Tiendanube (TIENDANUBE_APP_ID is accepted as alias of TIENDANUBE_CLIENT_ID)
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_USER_AGENT=StoreTalk (soporte@tudominio.com)

# Clerk: issuer/JWKS are derived from the publishable key (same instance as the frontend).
CLERK_PUBLISHABLE_KEY=
# Optional overrides
CLERK_ISSUER=
CLERK_JWKS_URL=
# Comma-separated origins allowed in the JWT `azp` claim. Defaults to FRONTEND_ORIGIN.
CLERK_AUTHORIZED_PARTIES=
